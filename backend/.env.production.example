# Прод-конфиг для my-vps (ml.saribek.uz). Реальный .env создаётся на сервере.
DEBUG=False
SECRET_KEY=__сгенерировать_на_сервере__
ALLOWED_HOSTS=ml.saribek.uz,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ml.saribek.uz

# Существующий Postgres на my-vps (локальный сокет/порт 5432)
DB_NAME=rasul_dip
DB_USER=rasul_dip
DB_PASSWORD=__сгенерировать_на_сервере__
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery не используется (раннер на threading) — можно не задавать.
# REDIS_URL=redis://localhost:6379/0

# CORS — origin фронта. Пока фронт не задеплоен, оставить пустым/локалку.
CORS_ALLOWED_ORIGINS=http://localhost:3001

SENTIMENT_MODEL=tabularisai/multilingual-sentiment-analysis
MODEL_DEVICE=cpu
